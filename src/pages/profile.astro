---
import BaseLayout from '../layouts/BaseLayout.astro';
import CollectionStats from '../components/CollectionStats.tsx';
import CollectionGrid from '../components/CollectionGrid.tsx';
import Cart from '../components/Cart.tsx';
import ProfileHeader from '../components/ProfileHeader.tsx';
import ActivityLog from '../components/ActivityLog.tsx';
---

<BaseLayout title="Profile">
  <div class="max-w-7xl mx-auto p-6 mt-12 mb-24 flex flex-col lg:flex-row gap-12">
    
    <div class="lg:w-1/3 flex flex-col gap-12">
      <ProfileHeader client:load />
      <ActivityLog client:load />
    </div>

    <div class="lg:w-2/3">
      <div class="mb-12">
        <CollectionStats client:load />
      </div>
      
      <div class="text-mono text-xs mb-6 flex justify-between border-b border-[var(--ink-primary)] pb-2">
        <span>TOP OWNED OBJECTS</span>
        <a href="/collection?filter=OWNED" class="hover:text-[var(--accent-copper)] transition-colors">[ VIEW ALL ]</a>
      </div>
      
      <CollectionGrid filter="OWNED" limit={12} client:load />
    </div>
  </div>

  <Cart client:load />
</BaseLayout>
