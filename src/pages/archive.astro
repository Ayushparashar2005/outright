---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products } from '../data/products';
import { objectData } from '../data/objectData';
import Cart from '../components/Cart.tsx';
import ArchiveCartControls from '../components/ArchiveCartControls.tsx';
---

<BaseLayout title="Archive">
  <div class="max-w-4xl mx-auto p-6 mt-12 mb-24">
    <div class="text-mono-sm tracking-system mb-4">OUTRIGHT / ARCHIVE</div>
    <h1 class="text-hero mb-12">SYSTEM LOG</h1>

    <div class="receipt-rule mb-12"></div>

    <div class="space-y-12">
      {products.map((p, index) => (
        <div class="flex flex-col md:flex-row gap-8 items-start border-b border-[var(--ink-faded)] pb-12">
          
          <div class="w-full md:w-1/3 bg-[var(--ink-ghost)] aspect-[4/3] flex items-center justify-center relative overflow-hidden">
            {p.image ? (
              <img src={p.image} alt={p.name} class="w-full h-full object-contain p-4" loading="lazy" />
            ) : (
              <span class="text-mono opacity-50 absolute">IMG_MISSING</span>
            )}
          </div>

          <div class="flex-1 w-full text-mono">
            <div class="flex justify-between mb-4 text-h2">
              <span>{p.name}</span>
              <span>{index + 1 < 10 ? `0${index + 1}` : index + 1}</span>
            </div>
            
            <div class="space-y-2">
              <div class="flex justify-between">
                <span>SKU</span>
                <span class="dotted-leader"></span>
                <span>{p.sku}</span>
              </div>
              <div class="flex justify-between">
                <span>MODEL</span>
                <span class="dotted-leader"></span>
                <span>{p.model}</span>
              </div>
              <div class="flex justify-between">
                <span>COLOR</span>
                <span class="dotted-leader"></span>
                <span>{p.color}</span>
              </div>
              <div class="flex justify-between">
                <span>MATERIAL</span>
                <span class="dotted-leader"></span>
                <span>{p.material}</span>
              </div>
              <div class="flex justify-between">
                <span>RELEASE</span>
                <span class="dotted-leader"></span>
                <span>{p.release}</span>
              </div>
            </div>

            {objectData[p.id] && (
              <div class="mt-8 space-y-6 pt-6 border-t border-[var(--ink-faded)]">
                {objectData[p.id].lore && (
                  <div>
                    <div class="mb-2 text-[var(--ink-primary)]">LORE</div>
                    <p class="text-sm opacity-80 leading-relaxed">{objectData[p.id].lore}</p>
                  </div>
                )}
                {objectData[p.id].culturalTags && objectData[p.id].culturalTags.length > 0 && (
                  <div>
                    <div class="mb-2 text-[var(--ink-primary)]">CULTURAL RECORD</div>
                    <div class="flex flex-wrap gap-2">
                      {objectData[p.id].culturalTags.map(tag => (
                        <span class="text-xs border border-[var(--ink-faded)] px-2 py-1">{tag}</span>
                      ))}
                    </div>
                  </div>
                )}
                {objectData[p.id].relatedObjects && objectData[p.id].relatedObjects.length > 0 && (
                  <div>
                    <div class="mb-2 text-[var(--ink-primary)]">RELATIONSHIPS</div>
                    <div class="flex flex-wrap gap-2">
                      {objectData[p.id].relatedObjects.map(relId => {
                         const relProduct = products.find(prod => prod.id === relId);
                         return relProduct ? (
                           <a href={`/?highlight=${relId}`} class="text-xs hover:bg-[var(--ink-primary)] hover:text-[var(--paper-base)] border border-[var(--ink-primary)] px-2 py-1 transition-colors">
                             {relProduct.name}
                           </a>
                         ) : null;
                      })}
                    </div>
                  </div>
                )}
              </div>
            )}

            <div class="mt-8">
              <div class="mb-2">
                <a href={`/?highlight=${p.id}`} class="hover:opacity-50 inline-block border-b border-[var(--ink-primary)] pb-1">
                  [ VIEW IN SPATIAL CATALOG ]
                </a>
              </div>
              <ArchiveCartControls product={p} client:load />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  
  <Cart client:load />
</BaseLayout>
